---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
  title="Blog – Daniel Silva"
  description="Artículos sobre desarrollo backend, integración de IA, arquitectura de software y buenas prácticas de ingeniería."
>
  <section class="min-h-screen px-6 pt-32 pb-24">
    <div class="mx-auto max-w-3xl">
      <h2 class="mb-2 text-sm font-semibold uppercase tracking-widest text-accent">
        Blog
      </h2>
      <h1 class="mb-12 text-3xl font-bold tracking-tight text-title-section sm:text-4xl">
        Artículos y reflexiones
      </h1>

      <div class="space-y-8">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="card-interactive group block rounded-xl border border-border border-l-2 border-l-transparent bg-surface-elevated p-6 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-glow-border hover:border-l-accent hover:bg-glow-bg hover:shadow-[0_0_25px_var(--color-glow-shadow)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:hover:transform-none"
          >
            <div class="mb-3 flex flex-wrap items-center gap-3">
              <time class="text-xs text-text-accent-soft font-mono">
                {post.data.date.toLocaleDateString("es-ES", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>
              <div class="flex gap-2">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="rounded-full bg-glow-bg px-2.5 py-0.5 text-[10px] font-medium text-accent">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            <h3 class="mb-2 text-lg font-semibold text-title-card transition-colors duration-200 group-hover:text-accent">
              {post.data.title}
            </h3>
            <p class="text-sm leading-relaxed text-text-primary">
              {post.data.description}
            </p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent-muted transition-colors duration-200 group-hover:text-accent">
              Leer artículo
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-0.5">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
