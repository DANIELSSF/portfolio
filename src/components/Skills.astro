---
import { getLangFromUrl, t } from "@/i18n/translations";
const lang = getLangFromUrl(Astro.url);

const skillCategories = [
  {
    title: t(lang, "skills.languages"),
    items: [
      { name: "JavaScript", icon: "js" },
      { name: "TypeScript", icon: "ts" },
      { name: "Go", icon: "go" },
      { name: "SQL", icon: "sql" },
      { name: "NoSQL", icon: "nosql" },
    ],
  },
  {
    title: t(lang, "skills.backend"),
    items: [
      { name: "Node.js", icon: "node" },
      { name: "NestJS", icon: "nest" },
      { name: "Express.js", icon: "express" },
      { name: "REST APIs", icon: "api" },
      { name: "Microservicios", icon: "micro" },
      { name: "SOLID", icon: "solid" },
      { name: "Clean Code", icon: "clean" },
      { name: "Swagger", icon: "swagger" },
    ],
  },
  {
    title: t(lang, "skills.frontend"),
    items: [
      { name: "React.js", icon: "react" },
      { name: "Next.js", icon: "next" },
      { name: "Astro.js", icon: "astro" },
      { name: "Tailwind CSS", icon: "tailwind" },
    ],
  },
  {
    title: t(lang, "skills.databases"),
    items: [
      { name: "MongoDB", icon: "mongo" },
      { name: "PostgreSQL", icon: "postgres" },
      { name: "MySQL", icon: "mysql" },
      { name: "OracleSQL", icon: "oracle" },
    ],
  },
  {
    title: t(lang, "skills.cloud"),
    items: [
      { name: "GCP", icon: "gcp" },
      { name: "AWS", icon: "aws" },
      { name: "Docker", icon: "docker" },
      { name: "Git / GitHub", icon: "git" },
    ],
  },
  {
    title: t(lang, "skills.integrations"),
    items: [
      { name: "OpenAI API", icon: "openai" },
      { name: "Meta API", icon: "meta" },
      { name: "Google Calendar", icon: "gcal" },
      { name: "PayPal", icon: "paypal" },
    ],
  },
];
---

<section id="skills" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-widest text-accent">{t(lang, "skills.subtitle")}</h2>
    <h3 class="mb-12 text-3xl font-bold tracking-tight text-title-section sm:text-4xl">{t(lang, "skills.title")}</h3>

    <div class="space-y-10">
      {skillCategories.map((category) => (
        <div>
          <h4 class="mb-4 text-xs font-bold uppercase tracking-widest text-text-secondary">{category.title}</h4>
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
            {category.items.map((item) => (
              <div class="skill-card group relative flex flex-col items-center gap-3 rounded-xl border border-zinc-200 dark:border-white/[0.06] bg-white dark:bg-zinc-900/30 p-4 text-center transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-zinc-300 dark:hover:border-white/15 motion-reduce:hover:transform-none">
                <div class="skill-icon-wrap flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-surface-elevated transition-all duration-300 group-hover:border-glow-border group-hover:bg-glow-bg group-hover:shadow-[0_0_16px_var(--color-glow-shadow)]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-text-secondary transition-colors duration-300 group-hover:text-accent">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                </div>
                <span class="text-xs font-medium text-text-primary transition-colors duration-300 group-hover:text-text-heading">{item.name}</span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skill-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 0.75rem;
    opacity: 0;
    background: radial-gradient(
      circle at 50% 50%,
      var(--color-glow-bg) 0%,
      transparent 70%
    );
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .skill-card:hover::before {
    opacity: 1;
  }
</style>
