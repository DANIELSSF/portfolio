---
import SectionHeader from "./SectionHeader.astro";
import MarqueeRow from "./MarqueeRow.astro";
import { getLangFromUrl, t } from "@/i18n/translations";
import {
  siJavascript,
  siTypescript,
  siGo,
  siNodedotjs,
  siNestjs,
  siExpress,
  siSwagger,
  siReact,
  siNextdotjs,
  siAstro,
  siTailwindcss,
  siMongodb,
  siPostgresql,
  siMysql,
  siGooglecloud,
  siDocker,
  siGit,
  siGithub,
  siAnthropic,
  siMeta,
  siGooglecalendar,
  siPaypal,
} from "simple-icons";

const lang = getLangFromUrl(Astro.url);

interface Skill {
  name: string;
  iconPath: string | null;
}

/* ── Row 1: Languages + Backend ── */
const row1: Skill[] = [
  { name: "JavaScript", iconPath: siJavascript.path },
  { name: "TypeScript", iconPath: siTypescript.path },
  { name: "Go", iconPath: siGo.path },
  { name: "SQL", iconPath: null },
  { name: "NoSQL", iconPath: null },
  { name: "Node.js", iconPath: siNodedotjs.path },
  { name: "NestJS", iconPath: siNestjs.path },
  { name: "Express", iconPath: siExpress.path },
  { name: "REST APIs", iconPath: null },
  { name: "Microservicios", iconPath: null },
  { name: "SOLID", iconPath: null },
  { name: "Clean Code", iconPath: null },
  { name: "Swagger", iconPath: siSwagger.path },
];

/* ── Row 2: Frontend + Databases ── */
const row2: Skill[] = [
  { name: "React", iconPath: siReact.path },
  { name: "Next.js", iconPath: siNextdotjs.path },
  { name: "Astro", iconPath: siAstro.path },
  { name: "Tailwind CSS", iconPath: siTailwindcss.path },
  { name: "MongoDB", iconPath: siMongodb.path },
  { name: "PostgreSQL", iconPath: siPostgresql.path },
  { name: "MySQL", iconPath: siMysql.path },
  { name: "OracleSQL", iconPath: null },
];

/* ── Row 3: Cloud & DevOps + Integrations ── */
const row3: Skill[] = [
  { name: "GCP", iconPath: siGooglecloud.path },
  { name: "AWS", iconPath: null },
  { name: "Docker", iconPath: siDocker.path },
  { name: "Git", iconPath: siGit.path },
  { name: "GitHub", iconPath: siGithub.path },
  { name: "OpenAI API", iconPath: null },
  { name: "Claude Code", iconPath: siAnthropic.path },
  { name: "Meta API", iconPath: siMeta.path },
  { name: "Google Calendar", iconPath: siGooglecalendar.path },
  { name: "PayPal", iconPath: siPaypal.path },
  { name: "LLM Workflows", iconPath: null },
  { name: "MCP Integration", iconPath: null },
];
---

<section id="skills" class="py-24">
  <div class="mx-auto max-w-5xl px-6">
    <SectionHeader index="04" label={t(lang, "skills.subtitle")} title={t(lang, "skills.title")} />
  </div>

  <div class="marquee-container" data-reveal>
    <MarqueeRow skills={row1} />
    <MarqueeRow skills={row2} reverse />
    <MarqueeRow skills={row3} />
  </div>
</section>
