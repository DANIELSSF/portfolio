---
import { getLangFromUrl, t } from "@/i18n/translations";
const lang = getLangFromUrl(Astro.url);

const skillCategories = [
  { title: t(lang, "skills.languages"), items: ["JavaScript", "TypeScript", "Go", "SQL", "NoSQL"] },
  { title: t(lang, "skills.backend"), items: ["Node.js", "NestJS", "Express.js", "REST APIs", "Microservicios", "SOLID", "Clean Code", "Swagger"] },
  { title: t(lang, "skills.frontend"), items: ["React.js", "Next.js", "Astro.js", "Tailwind CSS"] },
  { title: t(lang, "skills.databases"), items: ["MongoDB", "PostgreSQL", "MySQL", "OracleSQL"] },
  { title: t(lang, "skills.cloud"), items: ["GCP (Cloud Run, GCS)", "AWS (S3, EC2, RDS)", "Docker", "Git / GitHub"] },
  { title: t(lang, "skills.integrations"), items: ["OpenAI API", "Meta API (WhatsApp)", "Google Calendar API", "PayPal"] },
];
---

<section id="skills" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-widest text-accent">{t(lang, "skills.subtitle")}</h2>
    <h3 class="mb-12 text-3xl font-bold tracking-tight text-title-section sm:text-4xl">{t(lang, "skills.title")}</h3>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {skillCategories.map((category) => (
        <div class="section-card card-interactive rounded-xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-zinc-900/40 p-6 shadow-sm dark:shadow-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:shadow-md hover:border-zinc-300 dark:hover:border-white/20 dark:hover:shadow-[0_0_25px_var(--color-glow-shadow)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:hover:transform-none">
          <h4 class="mb-5 text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">{category.title}</h4>
          <div class="flex flex-wrap gap-2">
            {category.items.map((item) => (
              <span class="rounded-md border border-zinc-200 dark:border-white/10 bg-zinc-50 dark:bg-zinc-800/50 px-3 py-1.5 text-sm text-zinc-700 dark:text-zinc-300 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-sm hover:border-zinc-400 dark:hover:border-zinc-500 hover:bg-white dark:hover:bg-zinc-700/50">{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
