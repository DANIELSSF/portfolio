---
import { getLangFromUrl, t } from "@/i18n/translations";
const lang = getLangFromUrl(Astro.url);

interface Skill {
  name: string;
  slug: string | null;
}

interface Category {
  title: string;
  items: Skill[];
}

const categories: Category[] = [
  {
    title: t(lang, "skills.languages"),
    items: [
      { name: "JavaScript", slug: "javascript" },
      { name: "TypeScript", slug: "typescript" },
      { name: "Go", slug: "go" },
      { name: "SQL", slug: null },
      { name: "NoSQL", slug: null },
    ],
  },
  {
    title: t(lang, "skills.backend"),
    items: [
      { name: "Node.js", slug: "nodedotjs" },
      { name: "NestJS", slug: "nestjs" },
      { name: "Express", slug: "express" },
      { name: "REST APIs", slug: null },
      { name: "Microservicios", slug: null },
      { name: "SOLID", slug: "solid" },
      { name: "Clean Code", slug: null },
      { name: "Swagger", slug: "swagger" },
    ],
  },
  {
    title: t(lang, "skills.frontend"),
    items: [
      { name: "React", slug: "react" },
      { name: "Next.js", slug: "nextdotjs" },
      { name: "Astro", slug: "astro" },
      { name: "Tailwind CSS", slug: "tailwindcss" },
    ],
  },
  {
    title: t(lang, "skills.databases"),
    items: [
      { name: "MongoDB", slug: "mongodb" },
      { name: "PostgreSQL", slug: "postgresql" },
      { name: "MySQL", slug: "mysql" },
      { name: "OracleSQL", slug: null },
    ],
  },
  {
    title: t(lang, "skills.cloud"),
    items: [
      { name: "GCP", slug: "googlecloud" },
      { name: "AWS", slug: "alamy" },
      { name: "Docker", slug: "docker" },
      { name: "Git", slug: "git" },
      { name: "GitHub", slug: "github" },
    ],
  },
  {
    title: t(lang, "skills.integrations"),
    items: [
      { name: "OpenAI API", slug: null },
      { name: "Claude Code", slug: "anthropic" },
      { name: "Meta API", slug: "meta" },
      { name: "Google Calendar", slug: "googlecalendar" },
      { name: "PayPal", slug: "paypal" },
      { name: "LLM Workflows", slug: null },
      { name: "MCP Integration", slug: "modelcontextprotocol" },
    ],
  },
];

const iconUrl = (slug: string) => `https://cdn.simpleicons.org/${slug}/white`;
---

<section id="skills" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-widest text-accent">{t(lang, "skills.subtitle")}</h2>
    <h3 class="mb-12 text-3xl font-bold tracking-tight text-title-section sm:text-4xl">{t(lang, "skills.title")}</h3>

    <div class="flex flex-col gap-8">
      {categories.map((cat) => (
        <div>
          <h4 class="mb-3 text-xs font-semibold uppercase tracking-wider text-text-secondary">{cat.title}</h4>
          <div class="flex flex-wrap gap-3">
            {cat.items.map((skill) => (
              <span class="skill-pill">
                {skill.slug ? (
                  <img
                    src={iconUrl(skill.slug)}
                    alt=""
                    width="16"
                    height="16"
                    loading="lazy"
                    class="skill-icon"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex'"
                  />
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="skill-icon-fallback" style="display:none">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="skill-icon-fallback">
                    <polyline points="16 18 22 12 16 6" />
                    <polyline points="8 6 2 12 8 18" />
                  </svg>
                )}
                <span>{skill.name}</span>
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Skill pill ── */
  .skill-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.875rem;
    color: var(--color-text-primary);
    transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .skill-pill:hover {
    border-color: var(--color-glow-border);
    background: var(--color-glow-bg);
    color: var(--color-text-heading);
  }

  /* Light mode */
  :root.light .skill-pill {
    border-color: rgba(0, 0, 0, 0.10);
    background: rgba(0, 0, 0, 0.03);
  }
  :root.light .skill-pill:hover {
    border-color: var(--color-glow-border);
    background: var(--color-glow-bg);
  }

  /* ── Icon: white SVGs from SimpleIcons ── */
  .skill-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.65;
    transition: opacity 0.2s ease, filter 0.2s ease;
  }

  /* Light mode: invert white → black */
  :root.light .skill-icon {
    filter: invert(1);
  }

  /* Hover: accent tint */
  .skill-pill:hover .skill-icon {
    opacity: 1;
    filter: brightness(0) invert(0.72) sepia(1) saturate(4) hue-rotate(170deg);
  }
  :root.light .skill-pill:hover .skill-icon {
    filter: brightness(0) invert(0.15) sepia(1) saturate(5) hue-rotate(170deg);
  }

  /* ── Fallback SVG icon ── */
  .skill-icon-fallback {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    color: var(--color-text-secondary);
    opacity: 0.65;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  .skill-pill:hover .skill-icon-fallback {
    color: var(--color-accent);
    opacity: 1;
  }
</style>
