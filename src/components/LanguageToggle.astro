---
import { getLangFromUrl } from "@/i18n/translations";
const lang = getLangFromUrl(Astro.url);
const otherLang = lang === "es" ? "en" : "es";
const otherPath = lang === "es" ? "/en/" : "/";
---

<a
  href={otherPath}
  class="inline-flex items-center gap-1.5 rounded-md border border-border px-2.5 py-1.5 text-xs font-medium text-text-secondary transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-glow-border hover:bg-glow-bg hover:text-text-heading"
  aria-label={`Switch to ${otherLang === "en" ? "English" : "Español"}`}
>
  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10" />
    <path d="M2 12h20" />
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
  </svg>
  {otherLang.toUpperCase()}
</a>
