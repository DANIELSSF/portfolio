---

<button
  class="theme-toggle group inline-flex items-center justify-center rounded-md border border-border p-2 text-text-secondary transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-glow-border hover:bg-glow-bg hover:text-text-heading active:scale-90"
  aria-label="Toggle theme"
>
  <!-- Sun icon (visible in dark mode) -->
  <svg
    class="theme-icon-sun h-3.5 w-3.5 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-active:rotate-90"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2" />
    <path d="M12 20v2" />
    <path d="m4.93 4.93 1.41 1.41" />
    <path d="m17.66 17.66 1.41 1.41" />
    <path d="M2 12h2" />
    <path d="M20 12h2" />
    <path d="m6.34 17.66-1.41 1.41" />
    <path d="m19.07 4.93-1.41 1.41" />
  </svg>
  <!-- Moon icon (visible in light mode) -->
  <svg
    class="theme-icon-moon h-3.5 w-3.5 transition-transform duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-active:-rotate-12"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
  </svg>
</button>

<style>
  .theme-icon-sun { display: block; }
  .theme-icon-moon { display: none; }
  :global(.light) .theme-icon-sun { display: none; }
  :global(.light) .theme-icon-moon { display: block; }
</style>
