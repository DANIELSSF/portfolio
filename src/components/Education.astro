---
import SectionHeader from "./SectionHeader.astro";
import { getLangFromUrl, t } from "@/i18n/translations";

const lang = getLangFromUrl(Astro.url);
---

<section id="education" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <SectionHeader index="05" label={t(lang, "education.subtitle")} title={t(lang, "education.title")} />

    <div class="section-card card-interactive group relative flex flex-col md:flex-row justify-between items-start md:items-center gap-4 p-6 rounded-2xl!" data-reveal>
      <div class="flex items-start gap-4">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center p-3 rounded-lg bg-surface-tag group-hover:bg-glow-bg transition-colors duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent/70 transition-colors duration-300 group-hover:text-accent">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z" />
            <path d="M6 12v5c3 3 9 3 12 0v-5" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-title-card">{t(lang, "education.degree")}</h3>
          <p class="text-sm text-accent-muted">{t(lang, "education.university")}</p>
          <p class="mt-3 text-sm leading-relaxed text-text-secondary">{t(lang, "education.topics")}</p>
        </div>
      </div>
      <time class="shrink-0 text-sm text-text-accent-soft font-mono">2018 – 2024</time>
    </div>
  </div>
</section>
