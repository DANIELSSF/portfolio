---
import LiquidButtonInner from "./LiquidButtonInner";

interface Props {
  text: string;
  href?: string;
  type?: "primary" | "ghost";
  download?: boolean;
}

const { text, href, type = "primary", download = false } = Astro.props;
---

<LiquidButtonInner text={text} href={href} type={type} download={download} client:load>
  <slot />
</LiquidButtonInner>
