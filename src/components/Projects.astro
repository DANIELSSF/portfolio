---
import { getCollection } from "astro:content";
import { getLangFromUrl, t } from "@/i18n/translations";

const lang = getLangFromUrl(Astro.url);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

const getTechColor = (tech: string) => {
  const colors: Record<string, string> = {
    "Node.js": "border-green-300 text-green-800 bg-green-100 dark:text-green-300 dark:border-green-400/20 dark:bg-green-400/10 hover:bg-green-200 dark:hover:bg-green-400/20",
    "TypeScript": "border-blue-300 text-blue-800 bg-blue-100 dark:text-blue-300 dark:border-blue-400/20 dark:bg-blue-400/10 hover:bg-blue-200 dark:hover:bg-blue-400/20",
    "Go": "border-cyan-300 text-cyan-800 bg-cyan-100 dark:text-cyan-300 dark:border-cyan-400/20 dark:bg-cyan-400/10 hover:bg-cyan-200 dark:hover:bg-cyan-400/20",
    "GCP": "border-amber-300 text-amber-800 bg-amber-100 dark:text-amber-300 dark:border-amber-400/20 dark:bg-amber-400/10 hover:bg-amber-200 dark:hover:bg-amber-400/20",
    "MongoDB": "border-emerald-300 text-emerald-800 bg-emerald-100 dark:text-emerald-300 dark:border-emerald-400/20 dark:bg-emerald-400/10 hover:bg-emerald-200 dark:hover:bg-emerald-400/20",
    "PostgreSQL": "border-indigo-300 text-indigo-800 bg-indigo-100 dark:text-indigo-300 dark:border-indigo-400/20 dark:bg-indigo-400/10 hover:bg-indigo-200 dark:hover:bg-indigo-400/20",
    "NestJS": "border-red-300 text-red-800 bg-red-100 dark:text-red-300 dark:border-red-400/20 dark:bg-red-400/10 hover:bg-red-200 dark:hover:bg-red-400/20",
    "ReactJS": "border-sky-300 text-sky-800 bg-sky-100 dark:text-sky-300 dark:border-sky-400/20 dark:bg-sky-400/10 hover:bg-sky-200 dark:hover:bg-sky-400/20",
    "React": "border-sky-300 text-sky-800 bg-sky-100 dark:text-sky-300 dark:border-sky-400/20 dark:bg-sky-400/10 hover:bg-sky-200 dark:hover:bg-sky-400/20",
    "MySQL": "border-orange-300 text-orange-800 bg-orange-100 dark:text-orange-300 dark:border-orange-400/20 dark:bg-orange-400/10 hover:bg-orange-200 dark:hover:bg-orange-400/20",
    "OpenAI": "border-teal-300 text-teal-800 bg-teal-100 dark:text-teal-300 dark:border-teal-400/20 dark:bg-teal-400/10 hover:bg-teal-200 dark:hover:bg-teal-400/20",
    "Meta API": "border-blue-300 text-blue-800 bg-blue-100 dark:text-blue-300 dark:border-blue-400/20 dark:bg-blue-400/10 hover:bg-blue-200 dark:hover:bg-blue-400/20",
    "AWS S3": "border-amber-300 text-amber-800 bg-amber-100 dark:text-amber-300 dark:border-amber-400/20 dark:bg-amber-400/10 hover:bg-amber-200 dark:hover:bg-amber-400/20",
    "AstroJS": "border-purple-300 text-purple-800 bg-purple-100 dark:text-purple-300 dark:border-purple-400/20 dark:bg-purple-400/10 hover:bg-purple-200 dark:hover:bg-purple-400/20",
    "Astro": "border-purple-300 text-purple-800 bg-purple-100 dark:text-purple-300 dark:border-purple-400/20 dark:bg-purple-400/10 hover:bg-purple-200 dark:hover:bg-purple-400/20",
    "Astro.js": "border-purple-300 text-purple-800 bg-purple-100 dark:text-purple-300 dark:border-purple-400/20 dark:bg-purple-400/10 hover:bg-purple-200 dark:hover:bg-purple-400/20",
    "Tailwind CSS": "border-cyan-300 text-cyan-800 bg-cyan-100 dark:text-cyan-300 dark:border-cyan-400/20 dark:bg-cyan-400/10 hover:bg-cyan-200 dark:hover:bg-cyan-400/20",
    "Pasarela de Pagos": "border-slate-300 text-slate-800 bg-slate-100 dark:text-slate-300 dark:border-slate-400/20 dark:bg-slate-400/10 hover:bg-slate-200 dark:hover:bg-slate-400/20",
    "SEO": "border-fuchsia-300 text-fuchsia-800 bg-fuchsia-100 dark:text-fuchsia-300 dark:border-fuchsia-400/20 dark:bg-fuchsia-400/10 hover:bg-fuchsia-200 dark:hover:bg-fuchsia-400/20",
    "Next.js": "border-zinc-300 text-zinc-800 bg-zinc-100 dark:text-zinc-300 dark:border-zinc-400/20 dark:bg-zinc-400/10 hover:bg-zinc-200 dark:hover:bg-zinc-400/20",
    "Redis": "border-red-300 text-red-800 bg-red-100 dark:text-red-300 dark:border-red-400/20 dark:bg-red-400/10 hover:bg-red-200 dark:hover:bg-red-400/20",
    "Docker": "border-blue-300 text-blue-800 bg-blue-100 dark:text-blue-300 dark:border-blue-400/20 dark:bg-blue-400/10 hover:bg-blue-200 dark:hover:bg-blue-400/20",
    "Stripe": "border-indigo-300 text-indigo-800 bg-indigo-100 dark:text-indigo-300 dark:border-indigo-400/20 dark:bg-indigo-400/10 hover:bg-indigo-200 dark:hover:bg-indigo-400/20",
    "Prisma": "border-indigo-300 text-indigo-800 bg-indigo-100 dark:text-indigo-300 dark:border-indigo-400/20 dark:bg-indigo-400/10 hover:bg-indigo-200 dark:hover:bg-indigo-400/20",
    "TRPC": "border-indigo-300 text-indigo-800 bg-indigo-100 dark:text-indigo-300 dark:border-indigo-400/20 dark:bg-indigo-400/10 hover:bg-indigo-200 dark:hover:bg-indigo-400/20",
    "Vercel": "border-zinc-300 text-zinc-800 bg-zinc-100 dark:text-zinc-300 dark:border-zinc-400/20 dark:bg-zinc-400/10 hover:bg-zinc-200 dark:hover:bg-zinc-400/20",
    "Railway": "border-zinc-300 text-zinc-800 bg-zinc-100 dark:text-zinc-300 dark:border-zinc-400/20 dark:bg-zinc-400/10 hover:bg-zinc-200 dark:hover:bg-zinc-400/20",
    "Google Calendar": "border-blue-300 text-blue-800 bg-blue-100 dark:text-blue-300 dark:border-blue-400/20 dark:bg-blue-400/10 hover:bg-blue-200 dark:hover:bg-blue-400/20",
  };
  return colors[tech] || "border-border text-text-primary bg-surface-tag hover:border-glow-border hover:bg-glow-bg hover:text-accent dark:border-border dark:text-text-primary dark:bg-surface-tag";
};
---

<section id="projects" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-widest text-accent">{t(lang, "projects.subtitle")}</h2>
    <h3 class="mb-12 text-3xl font-bold tracking-tight text-title-section sm:text-4xl">{t(lang, "projects.title")}</h3>

    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <article class="card-interactive group rounded-xl border border-border border-l-2 border-l-transparent bg-surface-elevated p-6 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-glow-border hover:border-l-accent hover:bg-glow-bg hover:shadow-[0_0_25px_var(--color-glow-shadow)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:hover:transform-none">
          <div class="mb-4 flex items-start justify-between">
            <div class="rounded-lg border border-border bg-surface-tag p-2.5 transition-colors duration-300 group-hover:border-glow-border group-hover:bg-glow-bg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent/70 transition-colors duration-300 group-hover:text-accent">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </div>
            <div class="flex items-center gap-3">
              {project.data.live && (
                <a href={project.data.live} target="_blank" rel="noopener noreferrer" class="text-accent/60 transition-colors duration-300 hover:text-accent" aria-label={`Ver demo de ${project.data.title}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                </a>
              )}
              {project.data.github && (
                <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="text-accent/60 transition-colors duration-300 hover:text-accent" aria-label={`Ver ${project.data.title} en GitHub`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
              )}
            </div>
          </div>

          <h4 class="mb-2 text-lg font-semibold text-title-card transition-colors duration-200 group-hover:text-accent">{project.data.title}</h4>
          <p class="mb-4 min-h-[3rem] text-sm leading-relaxed text-text-primary">{project.data.description}</p>

          <div class="flex flex-wrap gap-2">
            {project.data.tech.map((tech: string) => (
              <span class={`rounded-full border px-3 py-1 text-xs transition-colors duration-200 ${getTechColor(tech)}`}>{tech}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
