---
import { getCollection } from "astro:content";
import { getLangFromUrl, t } from "@/i18n/translations";

const lang = getLangFromUrl(Astro.url);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-widest text-accent">{t(lang, "projects.subtitle")}</h2>
    <h3 class="mb-12 text-3xl font-bold tracking-tight text-text-heading sm:text-4xl">{t(lang, "projects.title")}</h3>

    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => (
        <article class="card-interactive group rounded-xl border border-border border-l-2 border-l-transparent bg-surface-elevated p-6 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:border-glow-border hover:border-l-accent hover:bg-glow-bg hover:shadow-[0_0_25px_var(--color-glow-shadow)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:hover:transform-none">
          <div class="mb-4 flex items-start justify-between">
            <div class="rounded-lg border border-border bg-surface-tag p-2.5 transition-colors duration-300 group-hover:border-glow-border group-hover:bg-glow-bg">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent/70 transition-colors duration-300 group-hover:text-accent">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                <path d="M9 18c-4.51 2-5-2-7-2" />
              </svg>
            </div>
            <div class="flex items-center gap-3">
              {project.data.live && (
                <a href={project.data.live} target="_blank" rel="noopener noreferrer" class="text-text-muted transition-colors duration-300 hover:text-accent" aria-label={`Ver demo de ${project.data.title}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <path d="M2 12h20" />
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                  </svg>
                </a>
              )}
              {project.data.github && (
                <a href={project.data.github} target="_blank" rel="noopener noreferrer" class="text-text-muted transition-colors duration-300 hover:text-accent" aria-label={`Ver ${project.data.title} en GitHub`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </a>
              )}
            </div>
          </div>

          <h4 class="mb-2 text-lg font-semibold text-text-heading transition-colors duration-200 group-hover:text-accent">{project.data.title}</h4>
          <p class="mb-4 min-h-[3rem] text-sm leading-relaxed text-text-primary">{project.data.description}</p>

          <div class="flex flex-wrap gap-2">
            {project.data.tech.map((tech: string) => (
              <span class="rounded-full border border-tag-border bg-tag-bg px-3 py-1 text-xs text-tag-text transition-all duration-200 hover:border-glow-border hover:bg-glow-bg hover:text-accent">{tech}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
