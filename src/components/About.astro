---
import SectionHeader from "./SectionHeader.astro";
import { getLangFromUrl, t } from "@/i18n/translations";

const lang = getLangFromUrl(Astro.url);

const paragraphs = [
  t(lang, "about.p1"),
  t(lang, "about.p2"),
  t(lang, "about.p3"),
];

const capabilities = [
  {
    title: t(lang, "about.cap1.title"),
    desc: t(lang, "about.cap1.desc"),
    icon: "api",
  },
  {
    title: t(lang, "about.cap2.title"),
    desc: t(lang, "about.cap2.desc"),
    icon: "db",
  },
  {
    title: t(lang, "about.cap3.title"),
    desc: t(lang, "about.cap3.desc"),
    icon: "cloud",
  },
  {
    title: t(lang, "about.cap4.title"),
    desc: t(lang, "about.cap4.desc"),
    icon: "nodes",
  },
];

const stats = [
  { value: 3, prefix: "", suffix: "+", label: t(lang, "about.stat1") },
  { value: 15, prefix: "", suffix: "+", label: t(lang, "about.stat2") },
  { value: 40, prefix: "+", suffix: "%", label: t(lang, "about.stat3") },
  { value: 4, prefix: "", suffix: "", label: t(lang, "about.stat4") },
];
---

<section id="about" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Left column: numbered paragraphs -->
      <div>
        <SectionHeader index="01" label="whoami" title={t(lang, "about.title")} />

        <div class="space-y-8" data-reveal-group>
          {paragraphs.map((p, i) => (
            <div class="flex gap-4" data-reveal-child style={`--reveal-delay: ${i * 90}ms`}>
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border bg-surface-elevated text-xs font-bold text-accent font-mono">
                {String(i + 1).padStart(2, "0")}
              </span>
              <p class="text-sm leading-loose text-text-secondary" set:html={p} />
            </div>
          ))}
        </div>
      </div>

      <!-- Right column: capabilities grid -->
      <div class="grid grid-cols-2 gap-4 content-start" data-reveal-group>
        {capabilities.map((cap, i) => (
          <div class="section-card card-interactive group p-5" data-reveal-child style={`--reveal-delay: ${i * 90}ms`}>
            <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-surface-elevated transition-colors duration-300 group-hover:border-glow-border group-hover:bg-glow-bg">
              {cap.icon === "api" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent/70 transition-colors duration-300 group-hover:text-accent">
                  <path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/>
                </svg>
              )}
              {cap.icon === "db" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent/70 transition-colors duration-300 group-hover:text-accent">
                  <ellipse cx="12" cy="5" rx="9" ry="3"/>
                  <path d="M3 5v14a9 3 0 0 0 18 0V5"/>
                  <path d="M3 12a9 3 0 0 0 18 0"/>
                </svg>
              )}
              {cap.icon === "cloud" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent/70 transition-colors duration-300 group-hover:text-accent">
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/>
                </svg>
              )}
              {cap.icon === "nodes" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-accent/70 transition-colors duration-300 group-hover:text-accent">
                  <rect width="6" height="6" x="2" y="2" rx="1"/>
                  <rect width="6" height="6" x="16" y="2" rx="1"/>
                  <rect width="6" height="6" x="9" y="16" rx="1"/>
                  <path d="M5 8v3a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8"/>
                  <path d="M12 12v4"/>
                </svg>
              )}
            </div>
            <h3 class="mb-1.5 text-sm font-semibold text-text-heading">{cap.title}</h3>
            <p class="text-xs leading-relaxed text-text-secondary">{cap.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Stats bar: counters animate on first view (Layout.astro script) -->
    <div class="mt-14 grid grid-cols-2 gap-4 sm:grid-cols-4" data-reveal-group>
      {stats.map((stat, i) => (
        <div class="flex flex-col items-center rounded-lg border border-border bg-surface-elevated p-4 text-center" data-reveal-child style={`--reveal-delay: ${i * 80}ms`}>
          <span class="text-2xl font-bold text-accent font-mono" data-counter data-target={stat.value} data-prefix={stat.prefix} data-suffix={stat.suffix}>{stat.prefix}{stat.value}{stat.suffix}</span>
          <span class="mt-1 text-xs text-text-secondary">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
