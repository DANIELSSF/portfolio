---
import TerminalHero from "./TerminalHero";
import LiquidButton from "./LiquidButton.astro";
import { getLangFromUrl, t } from "@/i18n/translations";

const lang = getLangFromUrl(Astro.url);
---

<section id="hero" class="relative flex min-h-screen items-center justify-center overflow-hidden px-6 pt-20">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute left-[20%] bottom-[-10%] h-[600px] w-[500px] rotate-12 rounded-full bg-sky-500/[0.035] blur-[150px]"></div>
    <div class="absolute left-[40%] bottom-[-5%] h-[500px] w-[400px] -rotate-6 rounded-full bg-emerald-400/[0.025] blur-[140px]"></div>
    <div class="absolute right-[25%] bottom-[-8%] h-[550px] w-[450px] rotate-3 rounded-full bg-orange-400/[0.02] blur-[160px]"></div>
    <div class="absolute right-[15%] bottom-[-12%] h-[400px] w-[350px] rotate-12 rounded-full bg-rose-500/[0.015] blur-[130px]"></div>
    <div class="absolute left-[10%] bottom-[-15%] h-[450px] w-[380px] -rotate-12 rounded-full bg-violet-500/[0.02] blur-[140px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-4xl">
    <div class="mb-10 text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-surface-elevated px-4 py-1.5 text-sm text-text-accent-soft transition-all duration-300 hover:border-glow-border hover:shadow-[0_0_15px_var(--color-glow-shadow)]">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500/50 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500/70"></span>
        </span>
        {t(lang, "hero.available")}
      </div>

      <h1 class="mb-4 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl">
        <span class="text-title-section">Daniel Santiago</span><br />
        <span class="text-blue-600 dark:text-blue-400">Silva Fonseca</span>
      </h1>

      <p class="mb-2 text-lg font-medium text-accent">
        {t(lang, "hero.role")}
      </p>

      <p class="mx-auto mb-8 max-w-2xl text-base leading-relaxed text-text-primary sm:text-lg">
        {t(lang, "hero.description")}
      </p>
    </div>

    <div class="mb-10">
      <TerminalHero client:load />
    </div>

    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <LiquidButton text={t(lang, "hero.cta")} href="#experience" type="primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </LiquidButton>

      <LiquidButton text="GitHub" href="https://github.com/DANIELSSF" type="ghost">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </LiquidButton>

      <LiquidButton text={t(lang, "hero.download")} href="/Daniel_Silva_CV.pdf" type="ghost" download>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="7 10 12 15 17 10" />
          <line x1="12" y1="15" x2="12" y2="3" />
        </svg>
      </LiquidButton>
    </div>
  </div>
</section>
