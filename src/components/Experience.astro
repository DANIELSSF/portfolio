---
import { getLangFromUrl, t } from "@/i18n/translations";
const lang = getLangFromUrl(Astro.url);

const getTechColor = (tech: string) => {
  // Light: outlined on white, solid brand borders/text (WCAG AA)
  // Dark: unchanged — tinted glass badges
  const colors: Record<string, string> = {
    "Node.js": "border-green-600 text-green-700 bg-white hover:bg-green-50 dark:text-green-300 dark:border-green-400/20 dark:bg-green-400/10 dark:hover:bg-green-400/20",
    "TypeScript": "border-blue-700 text-blue-800 bg-white hover:bg-blue-50 dark:text-blue-300 dark:border-blue-400/20 dark:bg-blue-400/10 dark:hover:bg-blue-400/20",
    "Go": "border-cyan-600 text-cyan-700 bg-white hover:bg-cyan-50 dark:text-cyan-300 dark:border-cyan-400/20 dark:bg-cyan-400/10 dark:hover:bg-cyan-400/20",
    "GCP": "border-zinc-500 text-zinc-700 bg-white hover:bg-zinc-50 dark:text-amber-300 dark:border-amber-400/20 dark:bg-amber-400/10 dark:hover:bg-amber-400/20",
    "MongoDB": "border-emerald-600 text-emerald-700 bg-white hover:bg-emerald-50 dark:text-emerald-300 dark:border-emerald-400/20 dark:bg-emerald-400/10 dark:hover:bg-emerald-400/20",
    "PostgreSQL": "border-indigo-600 text-indigo-700 bg-white hover:bg-indigo-50 dark:text-indigo-300 dark:border-indigo-400/20 dark:bg-indigo-400/10 dark:hover:bg-indigo-400/20",
    "NestJS": "border-red-600 text-red-700 bg-white hover:bg-red-50 dark:text-red-300 dark:border-red-400/20 dark:bg-red-400/10 dark:hover:bg-red-400/20",
    "ReactJS": "border-sky-600 text-sky-700 bg-white hover:bg-sky-50 dark:text-sky-300 dark:border-sky-400/20 dark:bg-sky-400/10 dark:hover:bg-sky-400/20",
    "React": "border-sky-600 text-sky-700 bg-white hover:bg-sky-50 dark:text-sky-300 dark:border-sky-400/20 dark:bg-sky-400/10 dark:hover:bg-sky-400/20",
    "MySQL": "border-orange-600 text-orange-700 bg-white hover:bg-orange-50 dark:text-orange-300 dark:border-orange-400/20 dark:bg-orange-400/10 dark:hover:bg-orange-400/20",
    "OpenAI": "border-zinc-500 text-zinc-700 bg-white hover:bg-zinc-50 dark:text-teal-300 dark:border-teal-400/20 dark:bg-teal-400/10 dark:hover:bg-teal-400/20",
    "Meta API": "border-blue-700 text-blue-800 bg-white hover:bg-blue-50 dark:text-blue-300 dark:border-blue-400/20 dark:bg-blue-400/10 dark:hover:bg-blue-400/20",
    "AWS S3": "border-zinc-500 text-zinc-700 bg-white hover:bg-zinc-50 dark:text-amber-300 dark:border-amber-400/20 dark:bg-amber-400/10 dark:hover:bg-amber-400/20",
    "AstroJS": "border-purple-600 text-purple-700 bg-white hover:bg-purple-50 dark:text-purple-300 dark:border-purple-400/20 dark:bg-purple-400/10 dark:hover:bg-purple-400/20",
    "Astro": "border-purple-600 text-purple-700 bg-white hover:bg-purple-50 dark:text-purple-300 dark:border-purple-400/20 dark:bg-purple-400/10 dark:hover:bg-purple-400/20",
    "Astro.js": "border-purple-600 text-purple-700 bg-white hover:bg-purple-50 dark:text-purple-300 dark:border-purple-400/20 dark:bg-purple-400/10 dark:hover:bg-purple-400/20",
    "Tailwind CSS": "border-cyan-600 text-cyan-700 bg-white hover:bg-cyan-50 dark:text-cyan-300 dark:border-cyan-400/20 dark:bg-cyan-400/10 dark:hover:bg-cyan-400/20",
    "Pasarela de Pagos": "border-slate-600 text-slate-700 bg-white hover:bg-slate-50 dark:text-slate-300 dark:border-slate-400/20 dark:bg-slate-400/10 dark:hover:bg-slate-400/20",
    "SEO": "border-fuchsia-600 text-fuchsia-700 bg-white hover:bg-fuchsia-50 dark:text-fuchsia-300 dark:border-fuchsia-400/20 dark:bg-fuchsia-400/10 dark:hover:bg-fuchsia-400/20",
    "Next.js": "border-zinc-500 text-zinc-700 bg-white hover:bg-zinc-50 dark:text-zinc-300 dark:border-zinc-400/20 dark:bg-zinc-400/10 dark:hover:bg-zinc-400/20",
    "Redis": "border-red-600 text-red-700 bg-white hover:bg-red-50 dark:text-red-300 dark:border-red-400/20 dark:bg-red-400/10 dark:hover:bg-red-400/20",
    "Docker": "border-blue-700 text-blue-800 bg-white hover:bg-blue-50 dark:text-blue-300 dark:border-blue-400/20 dark:bg-blue-400/10 dark:hover:bg-blue-400/20",
    "Stripe": "border-indigo-600 text-indigo-700 bg-white hover:bg-indigo-50 dark:text-indigo-300 dark:border-indigo-400/20 dark:bg-indigo-400/10 dark:hover:bg-indigo-400/20",
    "Prisma": "border-indigo-600 text-indigo-700 bg-white hover:bg-indigo-50 dark:text-indigo-300 dark:border-indigo-400/20 dark:bg-indigo-400/10 dark:hover:bg-indigo-400/20",
    "TRPC": "border-indigo-600 text-indigo-700 bg-white hover:bg-indigo-50 dark:text-indigo-300 dark:border-indigo-400/20 dark:bg-indigo-400/10 dark:hover:bg-indigo-400/20",
    "Vercel": "border-zinc-500 text-zinc-700 bg-white hover:bg-zinc-50 dark:text-zinc-300 dark:border-zinc-400/20 dark:bg-zinc-400/10 dark:hover:bg-zinc-400/20",
    "Railway": "border-zinc-500 text-zinc-700 bg-white hover:bg-zinc-50 dark:text-zinc-300 dark:border-zinc-400/20 dark:bg-zinc-400/10 dark:hover:bg-zinc-400/20",
    "Google Calendar": "border-blue-700 text-blue-800 bg-white hover:bg-blue-50 dark:text-blue-300 dark:border-blue-400/20 dark:bg-blue-400/10 dark:hover:bg-blue-400/20",
  };
  return colors[tech] || "border-zinc-500 text-zinc-700 bg-white hover:bg-zinc-50 dark:border-border dark:text-text-primary dark:bg-surface-tag dark:hover:border-glow-border dark:hover:bg-glow-bg";
};

const experiences = [
  {
    company: t(lang, "exp.estrellas.company"),
    role: t(lang, "exp.estrellas.role"),
    period: t(lang, "exp.estrellas.period"),
    description: [t(lang, "exp.estrellas.desc1"), t(lang, "exp.estrellas.desc2"), t(lang, "exp.estrellas.desc3"), t(lang, "exp.estrellas.desc4")],
    tech: ["Node.js", "TypeScript", "Go", "GCP", "MongoDB", "PostgreSQL"],
  },
  {
    company: t(lang, "exp.fox.company"),
    role: t(lang, "exp.fox.role"),
    period: t(lang, "exp.fox.period"),
    description: [t(lang, "exp.fox.desc1"), t(lang, "exp.fox.desc2")],
    tech: ["NestJS", "ReactJS", "MySQL", "OpenAI", "Meta API", "AWS S3"],
  },
  {
    company: t(lang, "exp.tcc.company"),
    role: t(lang, "exp.tcc.role"),
    period: t(lang, "exp.tcc.period"),
    description: [t(lang, "exp.tcc.desc1"), t(lang, "exp.tcc.desc2")],
    tech: ["NestJS", "AstroJS", "PostgreSQL", "Pasarela de Pagos"],
  },
  {
    company: t(lang, "exp.gsm.company"),
    role: t(lang, "exp.gsm.role"),
    period: t(lang, "exp.gsm.period"),
    description: [t(lang, "exp.gsm.desc1")],
    tech: ["AstroJS", "Tailwind CSS", "Node.js", "SEO"],
  },
];
---

<section id="experience" class="py-24 px-6">
  <div class="mx-auto max-w-5xl">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-widest text-accent">{t(lang, "experience.subtitle")}</h2>
    <h3 class="mb-12 text-3xl font-bold tracking-tight text-blue-600 dark:text-blue-400 sm:text-4xl">{t(lang, "experience.title")}</h3>

    <div class="relative">
      <div class="absolute left-0 top-0 hidden h-full w-px bg-gradient-to-b from-accent/40 via-accent/15 to-accent/5 md:block md:left-[7px]"></div>
      <div class="space-y-12">
        {experiences.map((exp) => (
          <article class="group relative md:pl-12">
            <div class="absolute left-0 top-1.5 hidden h-[15px] w-[15px] items-center justify-center md:flex">
              <div class="h-3 w-3 rounded-full border-2 border-accent/60 bg-accent/10 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:border-accent group-hover:bg-accent/40 group-hover:shadow-[0_0_8px_var(--color-glow-shadow)]" />
            </div>

            <div class="section-card card-interactive rounded-xl border border-zinc-200 dark:border-white/10 bg-white dark:bg-zinc-900/40 p-6 shadow-sm dark:shadow-none transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1 hover:shadow-md hover:border-zinc-300 dark:hover:border-white/20 dark:hover:shadow-[0_0_25px_rgba(30,58,138,0.2)] active:scale-[0.98] motion-reduce:transition-none motion-reduce:hover:transform-none">
              <div class="mb-4 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <h4 class="text-lg font-bold text-black dark:text-white transition-colors duration-200">{exp.company}</h4>
                  <p class="text-sm text-accent-muted">{exp.role}</p>
                </div>
                <time class="text-sm text-text-accent-soft font-mono">{exp.period}</time>
              </div>

              <ul class="mb-4 space-y-2">
                {exp.description.map((item) => (
                  <li class="flex gap-2 text-sm leading-relaxed text-text-primary">
                    <span class="mt-1.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent/50" />
                    {item}
                  </li>
                ))}
              </ul>

              <div class="flex flex-wrap gap-2">
                {exp.tech.map((tch) => (
                  <span class={`rounded-full border px-3 py-1 text-xs transition-colors duration-200 ${getTechColor(tch)}`}>{tch}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
